<%- include('partials/head', { title:'الإعدادات', page:'settings', user:user }) %>

<div class="mb-4">
  <h5 class="mb-0 fw-800">الإعدادات</h5>
  <small class="text-muted">إعدادات النظام والمحل والمستخدمين</small>
</div>

<ul class="nav nav-tabs mb-4">
  <li class="nav-item"><a class="nav-link active" href="#" onclick="switchTab('shop',this)"><i class="bi bi-shop me-1"></i>بيانات المحل</a></li>
  <li class="nav-item"><a class="nav-link" href="#" onclick="switchTab('users',this)"><i class="bi bi-people me-1"></i>المستخدمون</a></li>
  <li class="nav-item"><a class="nav-link" href="#" onclick="switchTab('password',this)"><i class="bi bi-lock me-1"></i>تغيير كلمة المرور</a></li>
</ul>

<!-- ══ Tab: Shop ══ -->
<div id="tab-shop">
  <div class="card" style="max-width:600px">
    <div class="card-header"><i class="bi bi-shop text-primary"></i> بيانات المحل</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label">اسم المحل <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="shopName" placeholder="اسم المحل">
        </div>
        <div class="col-12">
          <label class="form-label">العنوان</label>
          <input type="text" class="form-control" id="shopAddress" placeholder="العنوان بالتفصيل">
        </div>
        <div class="col-6">
          <label class="form-label">تليفون 1</label>
          <input type="tel" class="form-control" id="shopPhone" placeholder="01xxxxxxxxx">
        </div>
        <div class="col-6">
          <label class="form-label">تليفون 2</label>
          <input type="tel" class="form-control" id="shopPhone2" placeholder="اختياري">
        </div>
        <div class="col-12">
          <label class="form-label">الرقم الضريبي</label>
          <input type="text" class="form-control" id="shopTax" placeholder="اختياري">
        </div>
        <div class="col-12">
          <label class="form-label">نص الفاتورة (أسفل الإيصال)</label>
          <textarea class="form-control" id="shopNote" rows="2" placeholder="شكراً لتعاملكم معنا"></textarea>
        </div>
        <div class="col-12">
          <button class="btn btn-primary" onclick="saveShop()">
            <i class="bi bi-check2 me-1"></i>حفظ بيانات المحل
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Return settings -->
  <div class="card mt-3" style="max-width:600px">
    <div class="card-header"><i class="bi bi-arrow-return-right text-warning"></i> إعدادات المرتجعات</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label">الرقم السري للمرتجع</label>
          <input type="password" class="form-control" id="returnPin" placeholder="اتركه فارغاً لإلغاء الحماية" maxlength="10" style="direction:ltr;max-width:200px">
          <small class="text-muted">إذا تم تعيينه، سيُطلب الرقم السري قبل تنفيذ أي عملية مرتجع</small>
        </div>
        <div class="col-12">
          <button class="btn btn-primary" onclick="saveReturnPin()">
            <i class="bi bi-check2 me-1"></i>حفظ
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Preview -->
  <div class="card mt-3" style="max-width:320px">
    <div class="card-header"><i class="bi bi-eye text-primary"></i> معاينة الإيصال</div>
    <div class="card-body" id="receiptPreview" style="font-family:'Cairo',sans-serif;font-size:.85rem;text-align:center">
    </div>
  </div>
</div>

<!-- ══ Tab: Users ══ -->
<div id="tab-users" style="display:none">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div></div>
    <button class="btn btn-primary btn-sm" onclick="openUserModal()">
      <i class="bi bi-person-plus me-1"></i>مستخدم جديد
    </button>
  </div>
  <div class="card" style="max-width:700px">
    <div class="card-header"><i class="bi bi-people text-primary"></i> المستخدمون</div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>#</th><th>الاسم</th><th>اسم المستخدم</th><th>الصلاحية</th><th></th></tr></thead>
        <tbody id="usersBody"><tr><td colspan="5" class="text-center text-muted py-3">جاري التحميل...</td></tr></tbody>
      </table>
    </div>
  </div>
</div>

<!-- ══ Tab: Password ══ -->
<div id="tab-password" style="display:none">
  <div class="card" style="max-width:400px">
    <div class="card-header"><i class="bi bi-lock text-primary"></i> تغيير كلمة المرور</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label">كلمة المرور الحالية</label>
          <input type="password" class="form-control" id="pwdCurrent">
        </div>
        <div class="col-12">
          <label class="form-label">كلمة المرور الجديدة</label>
          <input type="password" class="form-control" id="pwdNew">
        </div>
        <div class="col-12">
          <label class="form-label">تأكيد كلمة المرور</label>
          <input type="password" class="form-control" id="pwdConfirm">
        </div>
        <div class="col-12">
          <button class="btn btn-primary" onclick="changePassword()">
            <i class="bi bi-check2 me-1"></i>تغيير كلمة المرور
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: مستخدم جديد/تعديل -->
<div class="modal fade" id="userModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title" id="userModalTitle">مستخدم جديد</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="uEditId">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="uFullName">
          </div>
          <div class="col-12">
            <label class="form-label">اسم المستخدم <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="uUsername">
          </div>
          <div class="col-12" id="pwdField">
            <label class="form-label">كلمة المرور <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="uPassword">
          </div>
          <div class="col-12">
            <label class="form-label">الصلاحية</label>
            <select class="form-select" id="uRole">
              <option value="admin">مدير</option>
              <option value="cashier">كاشير</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button class="btn btn-primary" onclick="saveUser()"><i class="bi bi-check2 me-1"></i>حفظ</button>
      </div>
    </div>
  </div>
</div>

<script>
const userModal = new bootstrap.Modal(document.getElementById('userModal'));

function switchTab(name, el) {
  document.querySelectorAll('.nav-tabs .nav-link').forEach(a=>a.classList.remove('active'));
  el.classList.add('active');
  ['shop','users','password'].forEach(t=>{
    document.getElementById(`tab-${t}`).style.display = t===name?'':'none';
  });
  if (name==='users') loadUsers();
  return false;
}

// ── Shop ──
async function loadShop() {
  const r = await fetch('/api/settings/shop');
  const { data } = await r.json();
  if (!data) return;
  document.getElementById('shopName').value    = data.shop_name||'';
  document.getElementById('shopAddress').value = data.address||'';
  document.getElementById('shopPhone').value   = data.phone||'';
  document.getElementById('shopPhone2').value  = data.phone2||'';
  document.getElementById('shopTax').value     = data.tax_number||'';
  document.getElementById('shopNote').value    = data.invoice_note||'';
  updatePreview(data);

  // Load return PIN
  const sr = await fetch('/api/settings');
  const sd = await sr.json();
  if (sd.success) document.getElementById('returnPin').value = sd.data.return_pin||'';
}

function updatePreview(data) {
  document.getElementById('receiptPreview').innerHTML = `
    <div style="font-weight:800;font-size:1rem">${data.shop_name||'اسم المحل'}</div>
    ${data.address?`<div style="font-size:.75rem;color:#666">${data.address}</div>`:''}
    ${data.phone?`<div style="font-size:.75rem;color:#666">📞 ${data.phone}</div>`:''}
    ${data.tax_number?`<div style="font-size:.72rem;color:#888">ضريبي: ${data.tax_number}</div>`:''}
    <hr style="border-top:1px dashed #ccc;margin:6px 0">
    <div style="font-size:.75rem;color:#888">${data.invoice_note||'شكراً لتعاملكم معنا'}</div>`;
}

// Live preview
['shopName','shopAddress','shopPhone','shopPhone2','shopTax','shopNote'].forEach(id=>{
  document.getElementById(id).addEventListener('input', ()=>{
    updatePreview({
      shop_name:    document.getElementById('shopName').value,
      address:      document.getElementById('shopAddress').value,
      phone:        document.getElementById('shopPhone').value,
      tax_number:   document.getElementById('shopTax').value,
      invoice_note: document.getElementById('shopNote').value
    });
  });
});

async function saveShop() {
  const body = {
    shop_name:    document.getElementById('shopName').value.trim(),
    address:      document.getElementById('shopAddress').value.trim(),
    phone:        document.getElementById('shopPhone').value.trim(),
    phone2:       document.getElementById('shopPhone2').value.trim(),
    tax_number:   document.getElementById('shopTax').value.trim(),
    invoice_note: document.getElementById('shopNote').value.trim()
  };
  if (!body.shop_name) return toast('اسم المحل مطلوب','error');

  const r = await api('PUT', '/api/settings/shop', body);
  if (r.success) toast(r.message);
  else toast(r.message,'error');
}

async function saveReturnPin() {
  const pin = document.getElementById('returnPin').value.trim();
  const r = await api('PUT', '/api/settings', { return_pin: pin });
  if (r.success) toast(r.message);
  else toast(r.message, 'error');
}

// ── Users ──
async function loadUsers() {
  const r = await fetch('/api/settings/users');
  const res = await r.json();
  const data = res.data || res.users || [];

  const roleLabels = { admin:'مدير', cashier:'كاشير' };
  const roleColors = { admin:'badge-overdue', cashier:'badge-cash' };

  const tb = document.getElementById('usersBody');
  if (!data.length) {
    tb.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">لا يوجد مستخدمون</td></tr>';
    return;
  }
  tb.innerHTML = data.map(u=>`
    <tr>
      <td>${u.id}</td>
      <td><strong>${u.full_name}</strong></td>
      <td class="text-muted">${u.username}</td>
      <td><span class="badge ${roleColors[u.role]||'badge-cash'} px-2">${roleLabels[u.role]||u.role}</span></td>
      <td>
        <button class="btn btn-sm btn-outline-primary" onclick="editUser(${u.id})">
          <i class="bi bi-pencil"></i>
        </button>
        ${u.username!=='admin'?`
        <button class="btn btn-sm btn-outline-danger ms-1" onclick="delUser(${u.id},'${u.full_name}')">
          <i class="bi bi-trash"></i>
        </button>`:''}
      </td>
    </tr>`).join('');
}

function openUserModal() {
  document.getElementById('uEditId').value   = '';
  document.getElementById('uFullName').value = '';
  document.getElementById('uUsername').value = '';
  document.getElementById('uPassword').value = '';
  document.getElementById('uRole').value     = 'cashier';
  document.getElementById('pwdField').style.display = '';
  document.getElementById('userModalTitle').textContent = 'مستخدم جديد';
  userModal.show();
}

async function editUser(id) {
  const r = await fetch(`/api/settings/users/${id}`);
  const res = await r.json();
  const u = res.data || res.user || res;
  document.getElementById('uEditId').value   = id;
  document.getElementById('uFullName').value = u.full_name;
  document.getElementById('uUsername').value = u.username;
  document.getElementById('uPassword').value = '';
  document.getElementById('uRole').value     = u.role;
  document.getElementById('pwdField').style.display = '';
  document.getElementById('userModalTitle').textContent = 'تعديل المستخدم';
  userModal.show();
}

async function saveUser() {
  const id   = document.getElementById('uEditId').value;
  const body = {
    full_name: document.getElementById('uFullName').value.trim(),
    username:  document.getElementById('uUsername').value.trim(),
    password:  document.getElementById('uPassword').value,
    role:      document.getElementById('uRole').value
  };
  if (!body.full_name||!body.username) return toast('الاسم واسم المستخدم مطلوبان','error');
  if (!id && !body.password) return toast('كلمة المرور مطلوبة','error');

  const r = await api(id?'PUT':'POST', id?`/api/settings/users/${id}`:'/api/settings/users', body);
  if (r.success) { toast(r.message); userModal.hide(); loadUsers(); }
  else toast(r.message,'error');
}

async function delUser(id, name) {
  if (!confirm(`حذف المستخدم "${name}"؟`)) return;
  const r = await api('DELETE', `/api/settings/users/${id}`);
  if (r.success) { toast(r.message); loadUsers(); }
  else toast(r.message,'error');
}

// ── Password ──
async function changePassword() {
  const current = document.getElementById('pwdCurrent').value;
  const newPwd  = document.getElementById('pwdNew').value;
  const confirm = document.getElementById('pwdConfirm').value;
  if (!current||!newPwd) return toast('يرجى ملء كل الحقول','error');
  if (newPwd !== confirm) return toast('كلمة المرور الجديدة غير متطابقة','error');

  const r = await api('POST', '/api/auth/change-password', { old_password: current, new_password: newPwd });
  if (r.success) {
    toast(r.message);
    ['pwdCurrent','pwdNew','pwdConfirm'].forEach(id=>document.getElementById(id).value='');
  } else toast(r.message,'error');
}

loadShop();
</script>

<%- include('partials/foot') %>
