<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'نظام الكاشير' %></title>

  <!-- Bootstrap 5 RTL -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Cairo Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary:      #1a6b3c;   /* أخضر داكن — لون تجاري محايد */
      --primary-light:#e8f5ee;
      --primary-mid:  #2d9657;
      --accent:       #f59e0b;   /* ذهبي للتنبيهات والأرباح */
      --danger:       #dc2626;
      --sidebar-bg:   #0f3d24;
      --sidebar-w:    240px;
      --topbar-h:     56px;
      --body-bg:      #f4f6f8;
      --card-bg:      #ffffff;
      --text-main:    #1e2a23;
      --text-muted:   #6b7280;
      --border:       #e5e7eb;
      --radius:       10px;
      --shadow:       0 1px 4px rgba(0,0,0,.08);
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Cairo', sans-serif;
      background: var(--body-bg);
      color: var(--text-main);
      margin: 0;
    }

    /* ── Sidebar ── */
    #sidebar {
      position: fixed;
      top: 0; right: 0;
      width: var(--sidebar-w);
      height: 100vh;
      background: var(--sidebar-bg);
      display: flex;
      flex-direction: column;
      z-index: 1040;
      transition: transform .25s ease;
    }
    .sidebar-brand {
      padding: 18px 20px 14px;
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .sidebar-brand .brand-name {
      font-size: 1.1rem;
      font-weight: 800;
      color: #fff;
      line-height: 1.2;
    }
    .sidebar-brand .brand-sub {
      font-size: .72rem;
      color: rgba(255,255,255,.45);
    }
    .sidebar-nav { flex: 1; overflow-y: auto; padding: 10px 0; }
    .sidebar-nav .nav-section {
      font-size: .65rem;
      font-weight: 700;
      color: rgba(255,255,255,.3);
      letter-spacing: .08em;
      padding: 16px 20px 4px;
      text-transform: uppercase;
    }
    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 20px;
      color: rgba(255,255,255,.7);
      text-decoration: none;
      font-size: .88rem;
      font-weight: 500;
      border-radius: 0;
      transition: background .15s, color .15s;
    }
    .sidebar-nav a:hover  { background: rgba(255,255,255,.07); color: #fff; }
    .sidebar-nav a.active {
      background: var(--primary-mid);
      color: #fff;
      font-weight: 700;
    }
    .sidebar-nav a .bi { font-size: 1rem; opacity: .85; }
    .sidebar-footer {
      padding: 14px 20px;
      border-top: 1px solid rgba(255,255,255,.08);
      font-size: .78rem;
      color: rgba(255,255,255,.35);
    }

    /* ── Topbar ── */
    #topbar {
      position: fixed;
      top: 0; left: 0;
      right: var(--sidebar-w);
      height: var(--topbar-h);
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      z-index: 1030;
    }
    .topbar-title { font-size: 1rem; font-weight: 700; color: var(--text-main); }
    .topbar-user  { font-size: .82rem; color: var(--text-muted); display:flex; align-items:center; gap:8px; }
    .topbar-name  { font-weight: 600; color: var(--text-main); }
    .topbar-user .avatar {
      width: 32px; height: 32px;
      background: var(--primary-light);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: var(--primary);
      font-weight: 700;
      font-size: .8rem;
    }

    /* ── Main content ── */
    #main {
      margin-right: var(--sidebar-w);
      margin-top: var(--topbar-h);
      padding: 24px;
      min-height: calc(100vh - var(--topbar-h));
    }

    /* ── Cards ── */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .card-header {
      background: transparent;
      border-bottom: 1px solid var(--border);
      padding: 14px 20px;
      font-weight: 700;
      font-size: .95rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ── KPI Cards ── */
    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 20px;
      box-shadow: var(--shadow);
    }
    .kpi-label  { font-size: .78rem; color: var(--text-muted); font-weight: 600; }
    .kpi-value  { font-size: 1.6rem; font-weight: 800; line-height: 1.2; margin: 2px 0; }
    .kpi-icon   {
      width: 42px; height: 42px;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
    }
    .kpi-green  { background: var(--primary-light); color: var(--primary); }
    .kpi-amber  { background: #fef3c7; color: #b45309; }
    .kpi-red    { background: #fee2e2; color: var(--danger); }
    .kpi-blue   { background: #dbeafe; color: #1d4ed8; }

    /* ── Tables ── */
    .table { font-size: .875rem; }
    .table thead th {
      background: #f9fafb;
      font-weight: 700;
      color: var(--text-muted);
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      border-bottom: 1px solid var(--border);
      padding: 10px 14px;
    }
    .table tbody td { padding: 10px 14px; vertical-align: middle; }
    .table-hover tbody tr:hover { background: var(--primary-light); }

    /* ── Buttons ── */
    .btn-primary {
      background: var(--primary);
      border-color: var(--primary);
      font-weight: 600;
    }
    .btn-primary:hover { background: #155a32; border-color: #155a32; }
    .btn-outline-primary {
      color: var(--primary);
      border-color: var(--primary);
      font-weight: 600;
    }
    .btn-outline-primary:hover {
      background: var(--primary);
      border-color: var(--primary);
    }

    /* ── Badges ── */
    .badge-paid     { background: var(--primary-light); color: var(--primary);   font-weight: 700; }
    .badge-pending  { background: #fef3c7;              color: #92400e;          font-weight: 700; }
    .badge-overdue  { background: #fee2e2;              color: var(--danger);    font-weight: 700; }
    .badge-cash     { background: #dbeafe;              color: #1e40af;          font-weight: 700; }

    /* ── Forms ── */
    .form-control, .form-select {
      border-radius: 8px;
      border-color: var(--border);
      font-size: .88rem;
      font-family: 'Cairo', sans-serif;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(26,107,60,.12);
    }
    .form-label { font-weight: 600; font-size: .83rem; color: var(--text-main); }

    /* ── Modal ── */
    .modal-header {
      background: var(--primary);
      color: #fff;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .modal-header .btn-close { filter: invert(1); }
    .modal-title { font-weight: 700; }

    /* ── Alerts / toasts ── */
    #toast-container {
      position: fixed;
      bottom: 24px;
      left: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .toast-msg {
      padding: 12px 20px;
      border-radius: 8px;
      font-size: .875rem;
      font-weight: 600;
      color: #fff;
      box-shadow: 0 4px 12px rgba(0,0,0,.15);
      animation: slideUp .25s ease;
    }
    .toast-success { background: var(--primary); }
    .toast-error   { background: var(--danger); }
    .toast-info    { background: #2563eb; }
    @keyframes slideUp {
      from { opacity:0; transform:translateY(12px); }
      to   { opacity:1; transform:translateY(0); }
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      :root { --sidebar-w: 0px; }
      #sidebar { transform: translateX(100%); }
      #sidebar.open { transform: translateX(0); width: 240px; }
      #topbar { right: 0; }
      #main { margin-right: 0; padding: 16px; }
    }

    /* ── Utilities ── */
    .text-primary { color: var(--primary) !important; }
    .bg-primary   { background: var(--primary) !important; }
    .border-primary { border-color: var(--primary) !important; }
    .fw-800 { font-weight: 800; }
    .rounded-lg { border-radius: var(--radius); }
    .gap-2 { gap: .5rem; }
  </style>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</head>
<body>

<!-- Toast container -->
<div id="toast-container"></div>

<!-- Sidebar -->
<nav id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-name">🏪 <span id="sidebarShopName">نظام الكاشير</span></div>
    <div class="brand-sub">نظام إدارة المبيعات</div>
  </div>
  <div class="sidebar-nav">
    <div class="nav-section">المبيعات</div>
    <a href="/pos"       class="<%= page==='pos'?'active':''        %>"><i class="bi bi-cart3"></i> نقطة البيع</a>
    <a href="/invoices"  class="<%= page==='invoices'?'active':''   %>"><i class="bi bi-receipt"></i> الفواتير</a>
    <a href="/returns"   class="<%= page==='returns'?'active':''    %>"><i class="bi bi-arrow-return-right"></i> المرتجعات</a>

    <div class="nav-section">العملاء</div>
    <a href="/customers"    class="<%= page==='customers'?'active':''   %>"><i class="bi bi-people"></i> العملاء</a>
    <a href="/suppliers" class="<%= page==='suppliers'?'active':''%>"><i class="bi bi-truck"></i> الموردون</a>

    <div class="nav-section">المخزون</div>
    <a href="/warehouses" class="<%= page==='warehouses'?'active':''%>"><i class="bi bi-building"></i> المخازن</a>
    <a href="/stock-add" class="<%= page==='stock-add'?'active':''  %>"><i class="bi bi-box-arrow-in-down"></i> إذن إضافة</a>
    <a href="/stock-return" class="<%= page==='stock-return'?'active':''%>"><i class="bi bi-box-arrow-up"></i> إذن مرتجع</a>
    <a href="/stock-movements" class="<%= page==='stock-movements'?'active':''%>"><i class="bi bi-arrow-left-right"></i> حركات الصنف</a>
    <a href="/stock-report" class="<%= page==='stock-report'?'active':''%>"><i class="bi bi-clipboard-data"></i> تقرير المخزن</a>
    <a href="/low-stock" class="<%= page==='lowstock'?'active':''   %>"><i class="bi bi-exclamation-triangle"></i> تحذيرات المخزون</a>

    <div class="nav-section">التقارير</div>
    <a href="/reports"   class="<%= page==='reports'?'active':''    %>"><i class="bi bi-bar-chart-line"></i> التقارير</a>

    <div class="nav-section">الإعدادات</div>
    <a href="/settings"  class="<%= page==='settings'?'active':''   %>"><i class="bi bi-gear"></i> الإعدادات</a>
  </div>
  <div class="sidebar-footer">
    <div>المستخدم: <strong style="color:rgba(255,255,255,.6)"><%= user?.full_name || 'مدير' %></strong></div>
    <form action="/api/auth/logout" method="POST" style="display:inline;margin:0;padding:0">
      <button type="submit" style="background:none;border:none;color:rgba(255,255,255,.35);font-size:.75rem;cursor:pointer;padding:0">
        <i class="bi bi-box-arrow-left"></i> تسجيل خروج
      </button>
    </form>
  </div>
</nav>

<!-- Topbar -->
<div id="topbar">
  <div class="d-flex align-items-center gap-3">
    <button class="btn btn-sm d-md-none" onclick="toggleSidebar()">
      <i class="bi bi-list fs-5"></i>
    </button>
    <span class="topbar-title"><%= title || 'نظام الكاشير' %></span>
  </div>
  <div class="topbar-user">
    <span class="d-none d-md-inline"><%= new Date().toLocaleDateString('ar-EG') %></span>
    <span class="topbar-name d-none d-sm-inline"><%= user?.full_name || user?.username || 'مدير' %></span>
    <div class="avatar" title="<%= user?.full_name || user?.username || 'المستخدم' %>"><%= (user?.full_name||'م')[0] %></div>
  </div>
</div>

<!-- Main -->
<main id="main">
