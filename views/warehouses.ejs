<%- include('partials/head', { title:'المخازن', page:'warehouses', user:user }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h5 class="mb-0 fw-800">المخازن</h5>
    <small class="text-muted">عرض المخزن والأصناف وإدارة التصنيفات</small>
  </div>
  <% if (user && user.role === 'admin') { %>
  <button class="btn btn-primary" onclick="openProductModal()">
    <i class="bi bi-plus-lg me-1"></i> صنف جديد
  </button>
  <% } %>
</div>

<div class="row g-3" id="warehouseInfo">
  <div class="col-12 text-center text-muted py-4">
    <div class="spinner-border text-primary"></div>
  </div>
</div>

<!-- التصنيفات -->
<div class="card mt-4">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-tags text-primary"></i> تصنيفات الأصناف</span>
    <% if (user && user.role === 'admin') { %>
    <button class="btn btn-sm btn-outline-primary" onclick="openCategoryModal()">
      <i class="bi bi-plus-lg me-1"></i> إضافة تصنيف
    </button>
    <% } %>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>#</th>
          <th>التصنيف</th>
          <th>عدد الأصناف</th>
          <th>إجمالي المخزون</th>
          <th>قيمة المخزون</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="categoriesTable">
        <tr><td colspan="6" class="text-center text-muted py-4">جارٍ التحميل...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-4">
  <h6 class="fw-800 mb-3"><i class="bi bi-box me-1"></i>المنتجات في المخزن</h6>
  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>المنتج</th>
          <th>الباركود</th>
          <th>الفئة</th>
          <th>الكمية</th>
          <th>سعر البيع</th>
          <% if (user && user.role === 'admin') { %><th>الإجراءات</th><% } %>
        </tr>
      </thead>
      <tbody id="stockTable">
        <tr><td colspan="<%= user && user.role === 'admin' ? 7 : 6 %>" class="text-center text-muted">جارٍ التحميل...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal تصنيف جديد / تعديل -->
<div class="modal fade" id="categoryModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:380px">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title" id="categoryModalTitle">تصنيف جديد</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="categoryId">
        <label class="form-label">اسم التصنيف <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="categoryName" maxlength="100" placeholder="مثال: مشروبات">
        <div class="text-danger small mt-1 d-none" id="categoryError"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button class="btn btn-primary" id="categorySaveBtn" onclick="saveCategory()">
          <i class="bi bi-check2 me-1"></i>حفظ
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal صنف جديد -->
<div class="modal fade" id="productModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title" id="productModalTitle">صنف جديد</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label">اسم الصنف <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="productName">
          </div>
          <div class="col-md-4">
            <label class="form-label">الباركود</label>
            <input type="text" class="form-control" id="productBarcode">
          </div>
          <div class="col-md-4">
            <label class="form-label">الفئة</label>
            <select class="form-select" id="productCategory">
              <option value="عام">عام</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">سعر التكلفة</label>
            <input type="number" class="form-control" id="productCost" step="0.01" min="0" placeholder="0.00">
          </div>
          <div class="col-md-4">
            <label class="form-label">سعر البيع <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="productPrice" step="0.01" min="0" placeholder="0.00">
          </div>
          <div class="col-md-4">
            <label class="form-label">الكمية الحالية</label>
            <input type="number" class="form-control" id="productQty" step="any" min="0" placeholder="0">
          </div>
          <div class="col-md-4">
            <label class="form-label">الحد الأدنى للتنبيه</label>
            <input type="number" class="form-control" id="productMinQty" step="any" min="0" placeholder="5">
          </div>
          <div class="col-md-4">
            <label class="form-label">الوحدة</label>
            <select class="form-select" id="productUnit">
              <option value="قطعة">قطعة</option>
              <option value="كيلو">كيلو</option>
              <option value="لتر">لتر</option>
              <option value="متر">متر</option>
              <option value="علبة">علبة</option>
              <option value="كرتون">كرتون</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">وصف</label>
            <textarea class="form-control" id="productDesc" rows="2"></textarea>
          </div>
        </div>
        <div class="text-danger small mt-2 d-none" id="productError"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button class="btn btn-primary" id="productSaveBtn" onclick="saveProduct()">
          <i class="bi bi-check2 me-1"></i>حفظ
        </button>
      </div>
    </div>
  </div>
</div>

<script>
const canManageCategories = <%= user && user.role === 'admin' ? 'true' : 'false' %>;
let categories = [];
let editingCategoryId = null;
let editingProductId = null;
const categoryModal = new bootstrap.Modal(document.getElementById('categoryModal'));
const productModal = new bootstrap.Modal(document.getElementById('productModal'));

function esc(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

async function loadWarehouse() {
  const r = await fetch('/api/warehouses');
  const res = await r.json();
  const warehouses = res.data || res.warehouses || [];
  const wh = warehouses[0];

  const info = document.getElementById('warehouseInfo');
  if (!wh) {
    info.innerHTML = '<div class="col-12"><div class="card"><div class="card-body text-center text-muted py-5"><i class="bi bi-building" style="font-size:3rem;opacity:.2"></i><div class="mt-2">لا يوجد مخزن</div></div></div></div>';
    return;
  }
  info.innerHTML = `<div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <h6 class="fw-800 mb-0"><i class="bi bi-building text-primary me-1"></i>${esc(wh.name)}</h6>
        ${wh.location ? `<div class="text-muted small mt-1"><i class="bi bi-geo-alt me-1"></i>${esc(wh.location)}</div>` : ''}
        ${wh.is_primary ? '<span class="badge bg-info mt-2">المخزن الرئيسي</span>' : ''}
      </div>
    </div>
  </div>`;
}

async function loadProducts() {
  const pr = await fetch('/api/products');
  const prRes = await pr.json();
  const products = prRes.data || [];
  const tbody = document.getElementById('stockTable');
  if (!products.length) {
    tbody.innerHTML = `<tr><td colspan="${canManageCategories ? 7 : 6}" class="text-center text-muted">لا توجد منتجات</td></tr>`;
    return;
  }
  tbody.innerHTML = products.map((p, i) => `<tr>
    <td>${i + 1}</td>
    <td>${esc(p.name)}</td>
    <td class="ltr">${esc(p.barcode || '-')}</td>
    <td>${p.category ? `<span class="badge badge-cash px-2">${esc(p.category)}</span>` : '-'}</td>
    <td>${p.stock ?? 0}</td>
    <td>${p.price ?? 0}</td>
    ${canManageCategories ? `<td class="text-nowrap">
      <button class="btn btn-sm btn-outline-primary" onclick="editProduct(${p.id})" title="تعديل الصنف"><i class="bi bi-pencil"></i></button>
      <button class="btn btn-sm btn-outline-danger ms-1" onclick="deleteProduct(${p.id})" title="حذف الصنف"><i class="bi bi-trash"></i></button>
    </td>` : ''}
  </tr>`).join('');
}

async function loadCategories() {
  const res = await fetch('/api/products/categories/details').then(r => r.json());
  categories = res.data || [];

  const categorySelect = document.getElementById('productCategory');
  if (categorySelect) {
    const selectedCategory = categorySelect.value;
    const categoryNames = [...new Set(['عام', ...categories.map(c => c.name).filter(Boolean)])];
    categorySelect.innerHTML = categoryNames.map(name =>
      `<option value="${esc(name)}" ${name === selectedCategory ? 'selected' : ''}>${esc(name)}</option>`
    ).join('');
  }

  const tbody = document.getElementById('categoriesTable');

  if (!categories.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">لا توجد تصنيفات — اضغط «إضافة تصنيف» لإضافة أول تصنيف</td></tr>';
    return;
  }

  tbody.innerHTML = categories.map((c, i) => `<tr>
    <td class="text-muted">${i + 1}</td>
    <td><span class="badge badge-cash px-2">${esc(c.name)}</span></td>
    <td>${c.products_count}</td>
    <td>${Number(c.total_stock || 0)}</td>
    <td>${fmt(c.total_value || 0)}</td>
    <td>
      ${canManageCategories ? `
      <button class="btn btn-sm btn-outline-primary" onclick="editCategory(${c.id})" title="تعديل">
        <i class="bi bi-pencil"></i>
      </button>
      <button class="btn btn-sm btn-outline-danger ms-1" onclick="deleteCategory(${c.id})" title="حذف">
        <i class="bi bi-trash"></i>
      </button>` : '<span class="text-muted">—</span>'}
    </td>
  </tr>`).join('');
}

function openCategoryModal() {
  editingCategoryId = null;
  document.getElementById('categoryId').value = '';
  document.getElementById('categoryName').value = '';
  document.getElementById('categoryError').classList.add('d-none');
  document.getElementById('categoryModalTitle').textContent = 'تصنيف جديد';
  categoryModal.show();
  setTimeout(() => document.getElementById('categoryName').focus(), 300);
}

function openProductModal() {
  editingProductId = null;
  ['productName', 'productBarcode', 'productCategory', 'productCost', 'productPrice', 'productQty', 'productMinQty', 'productDesc']
    .forEach(id => { document.getElementById(id).value = ''; });
  document.getElementById('productModalTitle').textContent = 'صنف جديد';
  document.getElementById('productUnit').value = 'قطعة';
  document.getElementById('productError').classList.add('d-none');
  productModal.show();
  setTimeout(() => document.getElementById('productName').focus(), 300);
}

async function editProduct(id) {
  const response = await fetch(`/api/products/${id}`);
  const result = await response.json();
  const product = result.data;
  if (!result.success || !product) return toast(result.message || 'تعذر تحميل بيانات الصنف', 'error');

  editingProductId = id;
  document.getElementById('productModalTitle').textContent = 'تعديل الصنف';
  document.getElementById('productName').value = product.name || '';
  document.getElementById('productBarcode').value = product.barcode || '';
  document.getElementById('productCategory').value = product.category || 'عام';
  document.getElementById('productCost').value = product.cost_price || 0;
  document.getElementById('productPrice').value = product.price || 0;
  document.getElementById('productQty').value = product.stock || 0;
  document.getElementById('productMinQty').value = product.min_quantity || 5;
  document.getElementById('productUnit').value = product.unit || 'قطعة';
  document.getElementById('productDesc').value = product.description || '';
  document.getElementById('productError').classList.add('d-none');
  productModal.show();
}

async function saveProduct() {
  const errorEl = document.getElementById('productError');
  const name = document.getElementById('productName').value.trim();
  const price = parseFloat(document.getElementById('productPrice').value) || 0;

  if (!name) {
    errorEl.textContent = 'اسم الصنف مطلوب';
    errorEl.classList.remove('d-none');
    return;
  }

  if (!price) {
    errorEl.textContent = 'سعر البيع مطلوب';
    errorEl.classList.remove('d-none');
    return;
  }

  const body = {
    name,
    barcode: document.getElementById('productBarcode').value.trim(),
    category: document.getElementById('productCategory').value.trim() || 'عام',
    price,
    cost_price: parseFloat(document.getElementById('productCost').value) || 0,
    quantity: parseFloat(document.getElementById('productQty').value) || 0,
    min_quantity: parseFloat(document.getElementById('productMinQty').value) || 5,
    unit: document.getElementById('productUnit').value,
    description: document.getElementById('productDesc').value.trim()
  };

  const btn = document.getElementById('productSaveBtn');
  btn.disabled = true;

  const res = editingProductId
    ? await api('PUT', `/api/products/${editingProductId}`, body)
    : await api('POST', '/api/products', body);
  btn.disabled = false;

  if (!res || !res.success) {
    errorEl.textContent = (res && res.message) || 'تعذر حفظ الصنف';
    errorEl.classList.remove('d-none');
    return;
  }

  productModal.hide();
  toast(res.message);
  await Promise.all([loadProducts(), loadCategories()]);
}

async function deleteProduct(id) {
  if (!confirm('هل تريد حذف هذا الصنف؟')) return;
  const result = await api('DELETE', `/api/products/${id}`);
  if (!result || !result.success) return toast((result && result.message) || 'تعذر حذف الصنف', 'error');
  toast(result.message);
  await Promise.all([loadProducts(), loadCategories()]);
}

function editCategory(id) {
  const category = categories.find(c => Number(c.id) === Number(id));
  if (!category) return;

  editingCategoryId = category.id;
  document.getElementById('categoryId').value = category.id;
  document.getElementById('categoryName').value = category.name;
  document.getElementById('categoryError').classList.add('d-none');
  document.getElementById('categoryModalTitle').textContent = 'تعديل التصنيف';
  categoryModal.show();
}

async function saveCategory() {
  const name = document.getElementById('categoryName').value.trim();
  const errorEl = document.getElementById('categoryError');

  if (!name) {
    errorEl.textContent = 'اسم التصنيف مطلوب';
    errorEl.classList.remove('d-none');
    return;
  }

  const btn = document.getElementById('categorySaveBtn');
  btn.disabled = true;

  const res = editingCategoryId
    ? await api('PUT', `/api/products/categories/${editingCategoryId}`, { name })
    : await api('POST', '/api/products/categories', { name });

  btn.disabled = false;

  if (!res || !res.success) {
    errorEl.textContent = (res && res.message) || 'تعذر حفظ التصنيف';
    errorEl.classList.remove('d-none');
    return;
  }

  categoryModal.hide();
  toast(res.message);
  await Promise.all([loadCategories(), loadProducts()]);
}

async function deleteCategory(id) {
  const category = categories.find(c => Number(c.id) === Number(id));
  if (!category) return;
  if (!confirm(`حذف التصنيف "${category.name}"؟`)) return;

  const res = await api('DELETE', `/api/products/categories/${id}`);
  if (!res || !res.success) return toast((res && res.message) || 'تعذر حذف التصنيف', 'error');

  toast(res.message);
  await loadCategories();
}

loadWarehouse();
loadCategories();
loadProducts();
</script>

<%- include('partials/foot') %>
