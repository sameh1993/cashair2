<%- include('partials/head', { title:'تحذيرات المخزون', page:'lowstock', user:user }) %>

<div class="mb-4">
  <h5 class="mb-0 fw-800">تحذيرات المخزون</h5>
  <small class="text-muted">الأصناف التي وصلت للحد الأدنى أو نفذت</small>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="kpi-card d-flex align-items-center gap-3">
      <div class="kpi-icon kpi-red"><i class="bi bi-x-circle"></i></div>
      <div><div class="kpi-label">نفذ تماماً</div><div class="kpi-value" id="kpiZero">—</div></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="kpi-card d-flex align-items-center gap-3">
      <div class="kpi-icon kpi-amber"><i class="bi bi-exclamation-triangle"></i></div>
      <div><div class="kpi-label">تحت الحد الأدنى</div><div class="kpi-value" id="kpiLow">—</div></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="bi bi-exclamation-triangle text-warning"></i> الأصناف التي تحتاج تعبئة</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>الصنف</th><th>الفئة</th><th>الكمية الحالية</th><th>الحد الأدنى</th><th>الحالة</th></tr>
      </thead>
      <tbody id="tableBody">
        <tr><td colspan="5" class="text-center text-muted py-4">جاري التحميل...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
async function load() {
  const r = await fetch('/api/products?low_stock=1');
  const res = await r.json();
  const data = (res.data||res.products||[]).filter(p=>p.stock<=(p.min_quantity||5));

  const zero = data.filter(p=>p.stock<=0).length;
  const low  = data.filter(p=>p.stock>0 && p.stock<=(p.min_quantity||5)).length;
  document.getElementById('kpiZero').textContent = zero;
  document.getElementById('kpiLow').textContent  = low;

  const tb = document.getElementById('tableBody');
  if (!data.length) {
    tb.innerHTML = '<tr><td colspan="5" class="text-center text-success py-4">✓ المخزون بحالة جيدة</td></tr>';
    return;
  }
  const sorted = data.sort((a,b)=>a.stock-b.stock);
  tb.innerHTML = sorted.map(p=>`
    <tr class="${p.stock<=0?'table-danger':'table-warning'}">
      <td><strong>${p.name}</strong></td>
      <td>${p.category?`<span class="badge badge-cash px-2">${p.category}</span>`:'—'}</td>
      <td class="fw-800 ${p.stock<=0?'text-danger':'text-warning'}">${p.stock} ${p.unit||'قطعة'}</td>
      <td class="text-muted">${p.min_quantity||5}</td>
      <td>${p.stock<=0
        ?'<span class="badge bg-danger px-2">نفذ تماماً</span>'
        :'<span class="badge bg-warning text-dark px-2">تحت الحد الأدنى</span>'}</td>
    </tr>`).join('');
}
load();
</script>

<%- include('partials/foot') %>
