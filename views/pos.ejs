<%- include('partials/head', { title:'نقطة البيع', page:'pos', user:user }) %>

  <style>
    /* POS layout overrides */
    #main {
      padding: 12px;
    }

    .pos-wrap {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 12px;
      height: calc(100vh - var(--topbar-h) - 24px);
    }

    /* Left: Products */
    .pos-products {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .prod-search-bar {
      padding: 10px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 10px;
    }

    .prod-grid {
      /* flex:1; */
      overflow-y: auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 8px;
      padding: 2px;
    }

    .prod-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 8px;
      cursor: pointer;
      text-align: center;
      transition: transform .12s, box-shadow .12s, border-color .12s;
      user-select: none;
    }

    .prod-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
      border-color: var(--primary);
    }

    .prod-card:active {
      transform: scale(.97);
    }

    .prod-card .prod-name {
      font-size: .8rem;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 4px;
    }

    .prod-card .prod-price {
      font-size: .95rem;
      font-weight: 800;
      color: var(--primary);
    }

    .prod-card .prod-stock {
      font-size: .7rem;
      color: #9ca3af;
      margin-top: 2px;
    }

    .prod-card.out-of-stock {
      opacity: .45;
      pointer-events: none;
    }

    /* Right: Cart */
    .pos-cart {
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .cart-header {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      background: #f9fafb;
    }

    .cart-customer {
      padding: 8px 14px;
      border-bottom: 1px solid var(--border);
    }

    .cart-items {
      flex: 1;
      overflow-y: auto;
    }

    .cart-item {
      padding: 8px 14px;
      border-bottom: 1px solid #f3f4f6;
    }

    .cart-item-top {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .cart-item-name {
      flex: 1;
      font-size: .83rem;
      font-weight: 600;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cart-item-del {
      color: #dc2626;
      cursor: pointer;
      font-size: .9rem;
      flex-shrink: 0;
    }

    .cart-item-fields {
      display: flex;
      gap: 8px;
      margin-top: 6px;
      padding-right: 4px;
    }

    .cart-field {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .cart-field label {
      font-size: .65rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .cart-field input {
      width: 70px;
      text-align: center;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: .82rem;
      font-weight: 700;
      padding: 4px 6px;
      font-family: 'Cairo', sans-serif;
    }

    .cart-field input:focus {
      border-color: var(--primary);
      outline: none;
      box-shadow: 0 0 0 2px rgba(26, 107, 60, .15);
    }

    .cart-field .qty-wrap {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .cart-field .qty-wrap input {
      width: 50px;
    }

    .qty-btn {
      width: 26px;
      height: 26px;
      border-radius: 5px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: .85rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      line-height: 1;
    }

    .qty-btn:hover {
      background: var(--primary-light);
    }

    .cart-total-field {
      font-size: .95rem;
      font-weight: 800;
      color: var(--primary);
      padding-top: 14px;
      min-width: 80px;
      text-align: center;
    }

    .cart-empty {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #9ca3af;
    }

    .cart-totals {
      padding: 10px 14px;
      border-top: 1px solid var(--border);
      background: #f9fafb;
      font-size: .88rem;
    }

    .cart-totals .total-row {
      display: flex;
      justify-content: space-between;
      padding: 3px 0;
    }

    .cart-totals .grand-total {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--primary);
      border-top: 2px solid var(--border);
      padding-top: 6px;
      margin-top: 4px;
    }

    .cart-actions {
      padding: 10px 14px;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .discount-row {
      display: flex;
      gap: 8px;
    }

    .discount-row input {
      flex: 1;
    }

    .pay-methods {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }

    .pay-btn {
      padding: 8px;
      border-radius: 8px;
      border: 2px solid var(--border);
      background: #fff;
      font-family: 'Cairo', sans-serif;
      font-size: .82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all .15s;
      text-align: center;
    }

    .pay-btn.active {
      border-color: var(--primary);
      background: var(--primary-light);
      color: var(--primary);
    }

    .btn-checkout {
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-family: 'Cairo', sans-serif;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      transition: background .15s;
      width: 100%;
    }

    .btn-checkout:hover {
      background: #155a32;
    }

    .btn-checkout:disabled {
      opacity: .5;
      cursor: not-allowed;
    }

    /* Receipt modal */
    .receipt {
      font-family: 'Cairo', sans-serif;
      max-width: 340px;
      margin: 0 auto;
    }

    .receipt-header {
      text-align: center;
      margin-bottom: 12px;
    }

    .receipt-divider {
      border-top: 1px dashed #ccc;
      margin: 8px 0;
    }

    .receipt-row {
      display: flex;
      justify-content: space-between;
      font-size: .85rem;
      padding: 2px 0;
    }

    .receipt-total {
      font-size: 1.1rem;
      font-weight: 800;
    }

    .cat-chips {
      padding: 0 2px;
    }

    .cat-chip {
      padding: 4px 14px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: .75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all .15s;
      user-select: none;
      font-family: 'Cairo', sans-serif;
    }

    .cat-chip:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .cat-chip.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    @media (max-width:900px) {
      .pos-wrap {
        grid-template-columns: 1fr;
        grid-template-rows: 1fr auto;
        height: auto;
      }

      .pos-products {
        height: 55vh;
      }
    }
  </style>

  <div class="pos-wrap">

    <!-- ══ LEFT: Products ══ -->
    <div class="pos-products">
      <div class="prod-search-bar">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
          <input type="text" class="form-control" id="prodSearch" placeholder="بحث باسم أو باركود..."
            oninput="filterProducts()" autofocus>
        </div>
      </div>
      <div class="cat-chips d-flex flex-wrap gap-1 px-1 mb-2" id="catChips"></div>
      <div class="prod-grid" id="prodGrid">
        <div class="text-center text-muted py-4" style="grid-column:1/-1">
          <div class="spinner-border text-primary"></div>
        </div>
      </div>
    </div>

    <!-- ══ RIGHT: Cart ══ -->
    <div class="pos-cart">
      <!-- Header -->
      <div class="cart-header d-flex justify-content-between align-items-center">
        <span class="fw-800"><i class="bi bi-cart3 text-primary me-1"></i>الفاتورة</span>
        <div class="d-flex gap-1">
          <button class="btn btn-sm btn-outline-warning" onclick="openReturnModal()" title="مرتجع">
            <i class="bi bi-arrow-return-right"></i>
          </button>
          <button class="btn btn-sm btn-outline-danger" onclick="clearCart()">
            <i class="bi bi-trash"></i> مسح
          </button>
        </div>
      </div>

      <!-- Invoice info -->
      <div class="cart-info" style="padding:6px 14px;border-bottom:1px solid var(--border);background:#fafcff;font-size:.78rem;display:flex;justify-content:space-between;align-items:center;">
        <span><span class="text-muted">رقم:</span> <strong id="liveInvoiceNum" style="color:var(--primary);font-size:.85rem;">—</strong></span>
        <span id="liveClock" style="color:var(--text-muted);font-weight:600;direction:ltr;text-align:left;"></span>
      </div>

      <!-- Customer -->
      <div class="cart-customer">
        <div class="d-flex gap-2 align-items-center">
          <select class="form-select form-select-sm" id="cartCustomer" style="flex:1">
            <option value="1">عميل نقدي</option>
          </select>
          <button class="btn btn-sm btn-outline-primary" onclick="openQuickCustomer()" title="عميل جديد">
            <i class="bi bi-person-plus"></i>
          </button>
        </div>
      </div>

      <!-- Items -->
      <div id="cartItemsWrap" class="cart-items">
        <div class="cart-empty" id="cartEmpty">
          <i class="bi bi-cart3" style="font-size:3rem;opacity:.2"></i>
          <div class="mt-2 small">اضغط على صنف للإضافة</div>
        </div>
        <div id="cartList"></div>
      </div>

      <!-- Totals -->
      <div class="cart-totals">
        <div class="total-row"><span class="text-muted">الإجمالي</span><span id="subtotalDisp">0.00 ج</span></div>
        <div class="total-row"><span class="text-muted">الخصم</span><span class="text-danger" id="discountDisp">-0.00
            ج</span></div>
        <div class="total-row grand-total"><span>الإجمالي النهائي</span><span id="grandTotal">0.00 ج</span></div>
      </div>

      <!-- Actions -->
      <div class="cart-actions">
        <div class="discount-row">
          <input type="number" class="form-control form-control-sm" id="discountAmt" placeholder="خصم (جنيه)" min="0"
            step="any" oninput="calcTotals()">
          <input type="number" class="form-control form-control-sm" id="discountPct" placeholder="خصم ٪" min="0"
            max="100" step="any" oninput="pctToAmt()" style="width:90px">
        </div>
        <div class="pay-methods">
          <button class="pay-btn active" id="pay-cash" onclick="setPayMethod('cash')"> 💵 نقدي</button>
          <button class="pay-btn" id="pay-visa" onclick="setPayMethod('visa')"> 💳 فيزا</button>
          <button class="pay-btn" id="pay-instapay" onclick="setPayMethod('instapay')"> 📲 انستاباي</button>
        </div>


        <button class="btn-checkout" id="checkoutBtn" onclick="checkout()" disabled>
          <i class="bi bi-check-circle me-2"></i>إتمام البيع
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: إيصال -->
  <div class="modal fade" id="receiptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px">
      <div class="modal-content">
        <div class="modal-header" style="background:var(--primary-light); border-bottom:1px solid var(--border)">
          <h6 class="modal-title text-primary fw-800"><i class="bi bi-receipt me-2"></i>الفاتورة</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-3" id="receiptBody"></div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary" data-bs-dismiss="modal" onclick="newSale()">
            <i class="bi bi-plus me-1"></i>فاتورة جديدة
          </button>
          <button class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>طباعة
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: عميل سريع -->
  <div class="modal fade" id="quickCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:360px">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title">عميل جديد</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">الاسم <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="qcName">
          </div>
          <div class="mb-3">
            <label class="form-label">التليفون</label>
            <input type="tel" class="form-control" id="qcPhone">
          </div>
          <div class="mb-3">
            <label class="form-label">النوع</label>
            <select class="form-select" id="qcType">
              <option value="cash">نقدي</option>
              <option value="credit">آجل</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
          <button class="btn btn-primary" onclick="saveQuickCustomer()">حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let _receiptModal, _quickCustModal;
    function getReceiptModal() { if (!_receiptModal) _receiptModal = new bootstrap.Modal(document.getElementById('receiptModal')); return _receiptModal; }
    function getQuickCustModal() { if (!_quickCustModal) _quickCustModal = new bootstrap.Modal(document.getElementById('quickCustomerModal')); return _quickCustModal; }

    let allProducts = [];
    let cart = [];   // [{product, qty, unit_price}]
    let payMethod = 'cash';
    let shopInfo = {};

    // ── Init ──
    async function init() {
      const [prodRes, custRes, shopRes, categoriesRes] = await Promise.all([
        fetch('/api/products?active=1', { credentials: 'same-origin' }).then(r => r.json()),
        fetch('/api/customers', { credentials: 'same-origin' }).then(r => r.json()),
        fetch('/api/settings/shop', { credentials: 'same-origin' }).then(r => r.json()),
        fetch('/api/products/categories', { credentials: 'same-origin' }).then(r => r.json())
      ]);
      allProducts = prodRes.data || prodRes.products || [];
      shopInfo = shopRes.data || {};

      // Categories
      renderCategories(categoriesRes?.data || []);
      renderProducts(allProducts);

      // Customers
      const custSel = document.getElementById('cartCustomer');
      (custRes?.data || []).filter(c => c.id > 1).forEach(c => {
        const o = document.createElement('option'); o.value = c.id; o.textContent = c.name; custSel.appendChild(o);
      });

    }

    // ── Products ──
    function renderProducts(list) {
      const grid = document.getElementById('prodGrid');
      if (!list.length) {
        grid.innerHTML = '<div class="text-center text-muted py-4" style="grid-column:1/-1">لا توجد أصناف</div>';
        return;
      }
      grid.innerHTML = list.map(p => `
    <div class="prod-card ${Number(p.stock) <= 0 ? 'out-of-stock' : ''}" onclick="addToCart(${p.id})">
      <div class="prod-name">${p.name}</div>
      <div class="prod-price">${fmt(p.price)}</div>
      <div class="prod-stock">${Number(p.stock) <= 0 ? 'نفذ' : p.stock + ' متاح'}</div>
    </div>`).join('');
    }

    function filterProducts() {
      const q = document.getElementById('prodSearch').value.toLowerCase();
      const cat = document.querySelector('#catChips .active')?.dataset?.cat || '';
      let list = allProducts;
      if (q) list = list.filter(p => p.name.toLowerCase().includes(q) || (p.barcode || '').includes(q));
      if (cat) list = list.filter(p => p.category === cat);
      renderProducts(list);
    }

    function renderCategories(categories) {
      const cats = [...new Set(categories.filter(c => c && c !== 'عام'))];
      const container = document.getElementById('catChips');
      container.innerHTML = `<button class="cat-chip active" data-cat="" onclick="selectCategory(this)">الكل</button>`;
      cats.forEach(c => {
        const b = document.createElement('button');
        b.className = 'cat-chip'; b.dataset.cat = c; b.textContent = c;
        b.onclick = () => selectCategory(b);
        container.appendChild(b);
      });
    }

    function selectCategory(el) {
      document.querySelectorAll('#catChips .cat-chip').forEach(b => b.classList.remove('active'));
      el.classList.add('active');
      filterProducts();
    }

    // ── Cart ──
    function addToCart(id) {
      const prod = allProducts.find(p => p.id === id);
      if (!prod) return;
      const existing = cart.find(i => i.product.id === id);
      if (existing) {
        if (existing.qty >= Number(prod.stock)) { toast('لا يوجد مخزون كافي', 'error'); return; }
        existing.qty++;
      } else {
        cart.push({ product: prod, qty: 1, unit_price: Number(prod.price) });
      }
      renderCart();
    }

    function changeQty(id, delta) {
      const item = cart.find(i => i.product.id === id);
      if (!item) return;
      item.qty = Math.max(0, item.qty + delta);
      if (item.qty === 0) cart = cart.filter(i => i.product.id !== id);
      renderCart();
    }

    function setQty(id, val) {
      const item = cart.find(i => i.product.id === id);
      if (!item) return;
      const q = parseFloat(val) || 0;
      if (q <= 0) { cart = cart.filter(i => i.product.id !== id); }
      else { item.qty = Math.min(q, Number(item.product.stock)); }
      renderCart();
    }

    function setUnitPrice(id, val) {
      const item = cart.find(i => i.product.id === id);
      if (!item) return;
      const p = parseFloat(val) || 0;
      item.unit_price = Math.max(0, p);
      renderCart();
    }

    function removeFromCart(id) {
      cart = cart.filter(i => i.product.id !== id);
      renderCart();
    }

    function clearCart() {
      cart = [];
      document.getElementById('discountAmt').value = '';
      document.getElementById('discountPct').value = '';
      document.getElementById('cartCustomer').value = '1';
      renderCart();
    }

    function renderCart() {
      const empty = document.getElementById('cartEmpty');
      const list = document.getElementById('cartList');
      if (!cart.length) {
        empty.style.display = 'flex';
        list.innerHTML = '';
        calcTotals();
        return;
      }
      empty.style.display = 'none';
      list.innerHTML = cart.map(item => `
    <div class="cart-item">
      <div class="cart-item-top">
        <div class="cart-item-name" title="${item.product.name}">${item.product.name}</div>
        <i class="bi bi-x-circle cart-item-del" onclick="removeFromCart(${item.product.id})"></i>
      </div>
      <div class="cart-item-fields">
        <div class="cart-field">
          <label>الكمية</label>
          <div class="qty-wrap">
            <button class="qty-btn" onclick="changeQty(${item.product.id},-1)">−</button>
            <input type="number" value="${item.qty}" min="0.001" step="any"
                   onchange="setQty(${item.product.id}, this.value)" onclick="this.select()">
            <button class="qty-btn" onclick="changeQty(${item.product.id},1)">+</button>
          </div>
        </div>
        <div class="cart-field">
          <label>سعر الوحدة</label>
          <input type="number" value="${item.unit_price}" min="0" step="any"
                 onchange="setUnitPrice(${item.product.id}, this.value)" onclick="this.select()">
        </div>
        <div class="cart-total-field">${fmt(item.unit_price * item.qty)}</div>
      </div>
    </div>`).join('');
      calcTotals();
    }

    function calcTotals() {
      const subtotal = cart.reduce((s, i) => s + i.unit_price * i.qty, 0);
      const discount = parseFloat(document.getElementById('discountAmt').value) || 0;
      const grand = Math.max(0, subtotal - discount);

      document.getElementById('subtotalDisp').textContent = fmt(subtotal);
      document.getElementById('discountDisp').textContent = '-' + fmt(discount);
      document.getElementById('grandTotal').textContent = fmt(grand);
      document.getElementById('checkoutBtn').disabled = cart.length === 0;

      calcInstPreview();
    }

    function pctToAmt() {
      const pct = parseFloat(document.getElementById('discountPct').value) || 0;
      const subtotal = cart.reduce((s, i) => s + i.unit_price * i.qty, 0);
      document.getElementById('discountAmt').value = (subtotal * pct / 100).toFixed(2);
      calcTotals();
    }

    function setPayMethod(m) {
      payMethod = m;
      document.querySelectorAll('.pay-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`pay-${m}`).classList.add('active');
    }

    // ── Checkout ──
    async function checkout() {
      if (!cart.length) return;
      const btn = document.getElementById('checkoutBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جاري الحفظ...';

      const subtotal = cart.reduce((s, i) => s + i.unit_price * i.qty, 0);
      const discount = parseFloat(document.getElementById('discountAmt').value) || 0;
      const total = Math.max(0, subtotal - discount);
      const customerId = parseInt(document.getElementById('cartCustomer').value) || 1;
      const customerEl = document.getElementById('cartCustomer');
      const customerName = customerEl.options[customerEl.selectedIndex]?.text || 'عميل نقدي';

      const body = {
        customer_id: customerId,
        customer_name: customerName,
        items: cart.map(i => ({ product_id: i.product.id, quantity: i.qty, unit_price: i.unit_price, product_name: i.product.name })),
        discount: discount,
        total,
        payment_method: { cash:'cash', visa:'card', instapay:'other' }[payMethod] || 'cash'
      };

      try {
        const r = await api('POST', '/api/invoices', body);
        if (!r.success) { toast(r.message, 'error'); return; }

        showReceipt(r.invoice_id || r.id, body, total, discount);
      } catch (e) {
        toast('خطأ في الاتصال', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>إتمام البيع';
      }
    }

    function showReceipt(invoiceId, body, total, discount) {
      const date = new Date().toLocaleString('ar-EG');
      document.getElementById('receiptBody').innerHTML = `
    <div class="receipt">
      <div class="receipt-header">
        <div style="font-size:1.1rem;font-weight:800">${shopInfo.shop_name || 'نظام الكاشير'}</div>
        ${shopInfo.address ? `<div style="font-size:.78rem;color:#666">${shopInfo.address}</div>` : ''}
        ${shopInfo.phone ? `<div style="font-size:.78rem;color:#666">📞 ${shopInfo.phone}</div>` : ''}
        <div class="receipt-divider"></div>
        <div style="font-size:.8rem;color:#666">فاتورة رقم: <strong>#${invoiceId}</strong></div>
        <div style="font-size:.78rem;color:#888">${date}</div>
        <div style="font-size:.8rem">العميل: <strong>${body.customer_name}</strong></div>
      </div>
      <div class="receipt-divider"></div>
      ${body.items.map(it => `
        <div class="receipt-row">
          <span>${it.product_name || it.name}</span>
          <span>${it.quantity} × ${fmt(it.price)}</span>
          <span>${fmt(it.quantity * it.price)}</span>
        </div>`).join('')}
      <div class="receipt-divider"></div>
      ${discount > 0 ? `<div class="receipt-row"><span>خصم</span><span class="text-danger">-${fmt(discount)}</span></div>` : ''}
      <div class="receipt-row receipt-total">
        <span>الإجمالي</span>
        <span style="color:var(--primary)">${fmt(total)}</span>
      </div>
      <div class="receipt-row"><span>طريقة الدفع</span><span>${{ cash: 'نقدي', card: 'فيزا', other: 'انستاباي' }[body.payment_method] || 'نقدي'}</span></div>
      <div class="receipt-divider"></div>
      <div style="text-align:center;font-size:.78rem;color:#888">${shopInfo.invoice_note || 'شكراً لتعاملكم معنا'}</div>
    </div>`;
      getReceiptModal().show();
    }

    function newSale() {
      clearCart();
      getReceiptModal().hide();
      // Refresh product stock
      init();
    }

    function openQuickCustomer() { getQuickCustModal().show(); }

    async function saveQuickCustomer() {
      const name = document.getElementById('qcName').value.trim();
      const phone = document.getElementById('qcPhone').value.trim();
      const type = document.getElementById('qcType').value;
      if (!name) return toast('الاسم مطلوب', 'error');

      const r = await api('POST', '/api/customers', { name, phone, customer_type: type });
      if (r.success) {
        const sel = document.getElementById('cartCustomer');
        const opt = document.createElement('option');
        opt.value = r.id; opt.textContent = name; opt.selected = true;
        sel.appendChild(opt);
        toast('تم إضافة العميل');
        getQuickCustModal().hide();
      } else toast(r.message, 'error');
    }

    // Barcode scanner (Enter key in search = direct add if one result)
    document.getElementById('prodSearch').addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        const q = e.target.value.trim();
        const found = allProducts.filter(p => (p.barcode || '') === q || p.name.toLowerCase() === q.toLowerCase());
        if (found.length === 1) { addToCart(found[0].id); e.target.value = ''; filterProducts(); }
      }
    });

    function updateClock() {
      const now = new Date();
      const dateStr = now.toLocaleDateString('ar-EG');
      const timeStr = now.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
      document.getElementById('liveClock').textContent = dateStr + ' ' + timeStr;
    }

    function generateTempInvoiceNum() {
      const now = new Date();
      const d = String(now.getDate()).padStart(2,'0');
      const m = String(now.getMonth()+1).padStart(2,'0');
      const h = String(now.getHours()).padStart(2,'0');
      const min = String(now.getMinutes()).padStart(2,'0');
      const s = String(now.getSeconds()).padStart(2,'0');
      return `INV-${d}${m}${h}${min}${s}`;
    }

    // Update temp invoice number on cart change
    const origRenderCart = renderCart;
    renderCart = function() {
      document.getElementById('liveInvoiceNum').textContent = cart.length ? generateTempInvoiceNum() : '—';
      origRenderCart();
    };

    setInterval(updateClock, 1000);
    updateClock();
    init();
  </script>

<!-- Return Modal -->
<div class="modal fade" id="posReturnModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-arrow-return-right text-warning me-1"></i>تسجيل مرتجع</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">رقم الفاتورة الأصلية <span class="text-danger">*</span></label>
          <div class="input-group">
            <select class="form-select" id="retInvoiceSelect">
              <option value="">-- اختر فاتورة --</option>
            </select>
            <button class="btn btn-outline-primary" onclick="loadReturnItems()"><i class="bi bi-search"></i> عرض</button>
          </div>
        </div>
        <div id="retInvoiceInfo" class="alert alert-info py-2 d-none"></div>
        <div id="retItemsArea" class="d-none">
          <label class="form-label fw-700 mt-2">الأصناف المرتجعة</label>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead>
                <tr><th style="width:40px">اختر</th><th>الصنف</th><th>سعر البيع</th><th>الكمية المباعة</th><th>سبق إرجاعه</th><th>متاح</th><th>الكمية</th></tr>
              </thead>
              <tbody id="retItemsBody"></tbody>
            </table>
          </div>
          <div class="mb-2 mt-2">
            <label class="form-label">سبب الإرجاع</label>
            <textarea class="form-control" id="retReason" rows="2" placeholder="اختياري"></textarea>
          </div>
          <div class="alert alert-warning py-2 d-flex justify-content-between">
            <span>إجمالي المرتجع:</span>
            <strong id="retTotal">0.00 ج</strong>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
        <button class="btn btn-danger" id="retConfirmBtn" onclick="confirmReturn()" style="display:none">
          <i class="bi bi-check2 me-1"></i>تأكيد الإرجاع
        </button>
      </div>
    </div>
  </div>
</div>

<script>
const retModal = new bootstrap.Modal(document.getElementById('posReturnModal'));
let retInvoiceData = null;

async function openReturnModal() {
  // Load recent invoices into select
  const r = await fetch('/api/invoices?limit=50');
  const res = await r.json();
  const invoices = res.data || [];
  const sel = document.getElementById('retInvoiceSelect');
  sel.innerHTML = '<option value="">-- اختر فاتورة --</option>' +
    invoices.map(inv => `<option value="${inv.id}">#${inv.invoice_number} — ${fmt(inv.net_total)} (${new Date(inv.created_at).toLocaleDateString('ar-EG')})</option>`).join('');
  document.getElementById('retItemsArea').classList.add('d-none');
  document.getElementById('retInvoiceInfo').classList.add('d-none');
  document.getElementById('retConfirmBtn').style.display = 'none';
  document.getElementById('retTotal').textContent = '0.00 ج';
  retModal.show();
}

async function loadReturnItems() {
  const id = document.getElementById('retInvoiceSelect').value;
  if (!id) return toast('اختر فاتورة', 'error');
  const r = await fetch(`/api/returns/invoice/${id}`);
  const res = await r.json();
  if (!res.success) return toast(res.message, 'error');
  retInvoiceData = res.data;
  const { invoice, items } = res.data;

  document.getElementById('retInvoiceInfo').classList.remove('d-none');
  document.getElementById('retInvoiceInfo').innerHTML = `<strong>فاتورة رقم:</strong> ${invoice.invoice_number} | <strong>العميل:</strong> ${invoice.customer_name || 'نقدي'} | <strong>الإجمالي:</strong> ${fmt(invoice.net_total)}`;

  const tbody = document.getElementById('retItemsBody');
  const hasAvail = items.some(it => it.available_to_return > 0);
  tbody.innerHTML = items.map(it => `
    <tr>
      <td><input type="checkbox" class="form-check-input" onchange="toggleRetItem(this)" ${it.available_to_return <= 0 ? 'disabled' : ''}></td>
      <td>${it.product_name || '—'}</td>
      <td>${fmt(it.unit_price)}</td>
      <td>${it.quantity}</td>
      <td>${it.already_returned || 0}</td>
      <td>${it.available_to_return}</td>
      <td><input type="number" class="form-control form-control-sm ret-qty" data-id="${it.product_id}" data-price="${it.unit_price}" data-name="${it.product_name || '—'}" min="0" max="${it.available_to_return}" step="0.001" style="width:80px" disabled oninput="calcRetTotal()"></td>
    </tr>`).join('');

  document.getElementById('retItemsArea').classList.remove('d-none');
  document.getElementById('retConfirmBtn').style.display = hasAvail ? '' : 'none';
  calcRetTotal();
}

function toggleRetItem(cb) {
  const row = cb.closest('tr');
  const qtyInput = row.querySelector('.ret-qty');
  qtyInput.disabled = !cb.checked;
  if (!cb.checked) qtyInput.value = '';
  calcRetTotal();
}

function calcRetTotal() {
  let total = 0;
  document.querySelectorAll('.ret-qty:not(:disabled)').forEach(inp => {
    const qty = parseFloat(inp.value) || 0;
    const price = parseFloat(inp.dataset.price) || 0;
    if (qty > 0) total += qty * price;
  });
  document.getElementById('retTotal').textContent = fmt(total);
}

async function confirmReturn() {
  const invoiceId = document.getElementById('retInvoiceSelect').value;
  const items = [];
  document.querySelectorAll('.ret-qty:not(:disabled)').forEach(inp => {
    const qty = parseFloat(inp.value) || 0;
    if (qty > 0) items.push({ product_id: parseInt(inp.dataset.id), product_name: inp.dataset.name, quantity: qty, unit_price: parseFloat(inp.dataset.price) });
  });
  if (!items.length) return toast('اختر أصناف وأدخل كميات', 'error');

  const settingsR = await fetch('/api/settings');
  const settingsData = await settingsR.json();
  const returnPin = settingsData.data?.return_pin || '';
  let pin = '';
  if (returnPin) {
    pin = await promptPin();
    if (!pin) return;
    const verifyR = await fetch('/api/returns/verify-pin', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pin })
    });
    const verifyRes = await verifyR.json();
    if (!verifyRes.success) return toast(verifyRes.message, 'error');
  }

  const r = await fetch('/api/returns', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ original_invoice_id: parseInt(invoiceId), items, reason: document.getElementById('retReason').value.trim(), pin })
  });
  const res = await r.json();
  if (res.success) { toast(res.message); retModal.hide(); loadProducts(); }
  else toast(res.message, 'error');
}
</script>

